# ==============================================================================
# Singh & Saturnus Law Firm - Production Apache / cPanel Security Configuration
# ==============================================================================

# 1. Disable Directory Index Browsing (prevents visitors from viewing directory lists)
Options -Indexes

# 2. Block access to hidden files and sensitive dotfiles (.git, .env, etc.)
<FilesMatch "^\.">
    Order allow,deny
    Deny from all
</FilesMatch>

# 3. Block dangerous or unnecessary HTTP methods
<LimitExcept GET POST HEAD>
    Order Allow,Deny
    Deny from all
</LimitExcept>

# 4. Enforce HTTPS automatically
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteCond %{HTTPS} off
    RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# 5. Security Response Headers
<IfModule mod_headers.c>
    # Prevent clickjacking / unauthorized framing
    Header always set X-Frame-Options "SAMEORIGIN"

    # Prevent MIME sniffing
    Header always set X-Content-Type-Options "nosniff"

    # XSS Protection for older browsers
    Header always set X-XSS-Protection "1; mode=block"

    # Strict Referrer Policy
    Header always set Referrer-Policy "strict-origin-when-cross-origin"

    # Restrict permissions
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"

    # HSTS (Strict Transport Security - 1 Year)
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"

    # Content Security Policy (CSP)
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; frame-src 'self' https://www.google.com https://maps.google.com; frame-ancestors 'self'; connect-src 'self'; base-uri 'self'; form-action 'self';"
</IfModule>

# 6. Proper MIME Types & UTF-8 Encoding
AddDefaultCharset UTF-8
